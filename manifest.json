{
  "manifest_version": 3,
  "name": "Google 日曆 - NCDR 六週降雨預報懸停卡片",
  "version": "1.0.0",
  "description": "在 Google 日曆中，將滑鼠移到任意日期格子上，立即浮現當天 NCDR 全台六週降雨預報圖！",
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/calendar/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://watch.ncdr.nat.gov.tw/*"
  ]
}
